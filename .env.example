# Vigilia - configuracion. Copie a .env y ajuste. Todo es opcional salvo la camara y (para el juez) GEMINI_API_KEY.
# Las camaras tambien se pueden agregar desde el panel web (http://127.0.0.1:5000).

# ---- Gemini (juez principal) -------------------------------------------------
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.8-flash        # verifique el nombre vigente en Google AI Studio
GEMINI_MAX_CALLS_PER_HOUR=120        # tope de gasto
GEMINI_COOLDOWN_SECONDS=20           # minimo entre consultas por persona
GEMINI_FRAMES=4                      # recortes por consulta
GEMINI_CROP_SIDE=384                 # lado maximo de cada recorte (menos = menos tokens)

# ---- Camaras (semilla inicial; luego viven en data/cameras.json) -------------
# Opcion A: URL completa.  Opcion B: campos separados (HOST, PROTOCOL, PORT, USER, PASSWORD, BRAND, PATH).
# CAMERA_1_NAME=Guardia pasillo
# CAMERA_1_URL=rtsp://192.168.1.64:554/Streaming/Channels/102
# CAMERA_1_USER=admin
# CAMERA_1_PASSWORD=
# CAMERA_2_HOST=192.168.1.65
# CAMERA_2_BRAND=dahua                # generico|hikvision|dahua|tapo|reolink|uniview|axis
MAX_CAMERAS=2

# ---- Rendimiento (CPU) ------------------------------------------------------
INFERENCE_FPS=5                      # analisis por segundo con gente en zona
IDLE_FPS=1.5                         # analisis por segundo con la zona vacia
MAX_FRAME_SIDE=640                   # 480 si el equipo es muy modesto
YOLO_MODEL=yolov8n-pose.pt
DEVICE=cpu                           # cuda:0 si hay GPU NVIDIA
FACE_ANALYSIS=auto                   # auto|on|off  (ojos cerrados / bostezos locales con MediaPipe)

# ---- Reglas de somnolencia ---------------------------------------------------
SUSPECT_SECONDS=5                    # sospecha local sostenida -> consulta a Gemini
SLEEP_SECONDS=12                     # sospecha fuerte sostenida -> estado local "dormida"
LOCAL_ONLY_DROWSY_SECONDS=20         # respaldo SIN Gemini: segundos para alertar somnolencia
LOCAL_ONLY_SLEEP_SECONDS=30          # respaldo SIN Gemini: segundos para alertar dormido
GEMINI_AWAKE_VETO_SECONDS=60         # si Gemini dice "despierta", silencio este tiempo
MIN_CONF_ASLEEP=0.6
MIN_CONF_DROWSY=0.5
REALERT_SECONDS=120                  # repetir alerta mientras persista
CAMERA_OFFLINE_SECONDS=60            # alerta de sistema si la camara pierde senal

# ---- Alertas y panel ------------------------------------------------------------
# ALERT_WEBHOOK_URL=https://...      # POST JSON de cada alerta (SMS/WhatsApp/Teams via integrador)
ALERT_RETENTION_DAYS=30
WEB_HOST=127.0.0.1                   # 0.0.0.0 para verlo desde otra PC (exige usuario/clave)
WEB_PORT=5000
# DASHBOARD_USER=
# DASHBOARD_PASSWORD=
LOG_LEVEL=info
